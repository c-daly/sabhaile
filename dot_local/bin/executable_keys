#!/usr/bin/env python3
"""keys: render KEYS.md as a terminal cheat sheet.

    keys               everything, paged
    keys tmux          one section (tmux, zsh, vim, clip, workflows)
    keys git           any heading that matches, e.g. telescope, oil, debug
    keys -s [query]    fuzzy-search every binding with fzf
    keys -l            list the sections

KEYS.md stays the only copy of the bindings. This script finds it in the
chezmoi source dir, or at $KEYS_MD if that is set.
"""

import os
import re
import shutil
import subprocess
import sys
import textwrap

ALIASES = {
    "vim": "neovim", "nvim": "neovim", "vi": "neovim",
    "clip": "clipboard", "work": "workflows", "shell": "zsh",
}

# 256-colour accents per top-level section; anything unlisted gets the default.
SECTION_COLOURS = {"tmux": 114, "zsh": 179, "neovim": 111, "cross-tool": 175, "common": 80}
DEFAULT_COLOUR = 146

COLOUR = sys.stdout.isatty() and "NO_COLOR" not in os.environ
ANSI_RE = re.compile(r"\033\[[0-9;]*m")


def sgr(*codes):
    return f"\033[{';'.join(str(c) for c in codes)}m" if COLOUR else ""


def reset():
    return sgr(0)


def visible_len(s):
    return len(ANSI_RE.sub("", s))


# --------------------------------------------------------------------------
# Finding and parsing KEYS.md
# --------------------------------------------------------------------------

def find_keys_md():
    if os.environ.get("KEYS_MD"):
        return os.environ["KEYS_MD"]
    try:
        src = subprocess.run(["chezmoi", "source-path"], capture_output=True,
                             text=True, check=True).stdout.strip()
        return os.path.join(src, "KEYS.md")
    except (OSError, subprocess.CalledProcessError):
        return os.path.expanduser("~/.local/share/chezmoi/KEYS.md")


def split_row(line):
    """Split a markdown table row on unescaped pipes."""
    s = line.strip()
    if s.startswith("|"):
        s = s[1:]
    if s.endswith("|") and not s.endswith("\\|"):
        s = s[:-1]
    return [c.strip().replace("\\|", "|") for c in re.split(r"(?<!\\)\|", s)]


BULLET_RE = re.compile(r"^(\s*)([-*]|\d+\.)\s+(.*)")


def parse(text):
    """Turn KEYS.md into a flat list of blocks: (kind, level, payload)."""
    blocks, para = [], []
    lines = text.splitlines()

    def flush():
        if para:
            blocks.append(("para", 0, " ".join(para)))
            para.clear()

    i = 0
    while i < len(lines):
        line = lines[i]
        stripped = line.strip()
        heading = re.match(r"^(#{1,3})\s+(.*)", line)
        bullet = BULLET_RE.match(line)
        if heading:
            flush()
            blocks.append(("heading", len(heading.group(1)), heading.group(2)))
        elif stripped.startswith("|"):
            flush()
            rows = []
            while i < len(lines) and lines[i].strip().startswith("|"):
                row = split_row(lines[i])
                if not all(re.fullmatch(r":?-+:?", c) for c in row):
                    rows.append(row)
                i += 1
            blocks.append(("table", 0, rows))
            continue
        elif bullet:
            flush()
            marker = bullet.group(2) if bullet.group(2)[0].isdigit() else "•"
            item = [bullet.group(3)]
            i += 1
            # continuation lines are indented and are not bullets themselves
            while i < len(lines) and lines[i].startswith("  ") and lines[i].strip() \
                    and not BULLET_RE.match(lines[i]):
                item.append(lines[i].strip())
                i += 1
            blocks.append(("bullet", marker, " ".join(item)))
            continue
        elif stripped in ("", "---"):
            flush()
        else:
            para.append(stripped)
        i += 1
    flush()
    return blocks


# --------------------------------------------------------------------------
# Inline markdown -> styled segments -> wrapped ANSI lines
# --------------------------------------------------------------------------

INLINE_RE = re.compile(r"`([^`]+)`|\*\*(.+?)\*\*|(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])")


def segments(text, style=frozenset()):
    """Yield (text, style) pairs; style is a set drawn from code/bold/italic."""
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)  # links -> their text
    pos = 0
    for m in INLINE_RE.finditer(text):
        if m.start() > pos:
            yield text[pos:m.start()], style
        if m.group(1) is not None:
            yield m.group(1), style | {"code"}
        elif m.group(2) is not None:
            yield from segments(m.group(2), style | {"bold"})
        else:
            yield from segments(m.group(3), style | {"italic"})
        pos = m.end()
    if pos < len(text):
        yield text[pos:], style


def plain(text):
    return "".join(t for t, _ in segments(text))


def paint(text, style, accent, base=()):
    codes = list(base)
    if "code" in style:
        codes += [1, 38, 5, accent]
    else:
        if "bold" in style:
            codes += [1]
        if "italic" in style:
            codes += [3, 2]
    return sgr(*codes) + text + reset() if codes and COLOUR else text


def words(text, accent, base=()):
    """Split into painted words; code spans never break internally."""
    out, current = [], ""
    for chunk, style in segments(text):
        if "code" in style:
            current += paint(chunk, style, accent, base)
            continue
        for part in re.split(r"(\s+)", chunk):
            if not part:
                continue
            if part.isspace():
                if current:
                    out.append(current)
                current = ""
            else:
                current += paint(part, style, accent, base)
    if current:
        out.append(current)
    return out


def wrap(text, width, accent, base=()):
    lines, line = [], ""
    for w in words(text, accent, base):
        if line and visible_len(line) + 1 + visible_len(w) > width:
            lines.append(line)
            line = w
        else:
            line = f"{line} {w}" if line else w
    if line:
        lines.append(line)
    return lines or [""]


# --------------------------------------------------------------------------
# Rendering
# --------------------------------------------------------------------------

def section_colour(title):
    key = title.lower().split(":")[0].split()[0]
    return SECTION_COLOURS.get(key, DEFAULT_COLOUR)


NOTE_RE = re.compile(r"\s*(\*\([^)]*\)\*|\([^)`]*\))\s*$")


def keys_first(rows):
    """Tables are Action|Keys or Keys|Action; always put the keys on the left,
    and move a trailing note in the keys cell, e.g. "*(tmux-yank)*", over to
    the action so the keys column stays narrow."""
    if rows and len(rows[0]) >= 2 and rows[0][1].lower() in ("keys", "key"):
        rows = [[r[1], r[0], *r[2:]] for r in rows]
    out = []
    for key, *rest in rows:
        note = NOTE_RE.search(key)
        if note and rest:
            note_text = note.group(1).strip("*")
            key, rest = key[:note.start()], [*rest[:-1], f"{rest[-1]} *{note_text}*"]
        out.append([key, *rest])
    return out


def render_table(rows, width, accent):
    body = keys_first(rows)[1:]
    if not body:
        return []
    key_w = min(max(visible_len(" ".join(words(r[0], accent))) for r in body), 30, width // 2)
    act_w = max(width - key_w - 6, 20)
    out = []
    for row in body:
        key_lines = wrap(row[0], key_w, accent)
        act_lines = wrap(" ".join(row[1:]), act_w, accent)
        if len(key_lines) > 1 or visible_len(key_lines[0]) > key_w:
            # a long key gets its own line(s); the action starts underneath
            out += ["    " + k for k in key_lines]
            key_lines = [""]
        for n in range(max(len(key_lines), len(act_lines))):
            k = key_lines[n] if n < len(key_lines) else ""
            a = act_lines[n] if n < len(act_lines) else ""
            out.append("    " + k + " " * (key_w - visible_len(k) + 2) + a)
    return out


def render(blocks, width):
    out, accent = [], DEFAULT_COLOUR
    for kind, level, payload in blocks:
        if kind == "heading":
            title = plain(payload)
            if level == 1:
                out += [sgr(1, 38, 5, 16, 48, 5, DEFAULT_COLOUR) + f"  {title}  ".center(width) + reset(), ""]
            elif level == 2:
                accent = section_colour(title)
                label = f" {title.upper()} "
                out += ["", sgr(1, 38, 5, 16, 48, 5, accent) + label + reset()
                        + sgr(38, 5, accent) + " " + "─" * max(width - len(label) - 1, 0) + reset(), ""]
            else:
                out += ["", "  " + sgr(1, 38, 5, accent) + "▸ " + title + reset()]
        elif kind == "table":
            out += render_table(payload, width - 2, accent) + [""]
        elif kind == "bullet":
            lines = wrap(payload, width - 8, accent)
            out.append(f"    {sgr(38, 5, accent)}{level}{reset()} {lines[0]}")
            out += [" " * (5 + len(level)) + l for l in lines[1:]]
        else:
            base = (2,) if payload.startswith("Source:") else ()
            if out and out[-1] != "":
                out.append("")
            out += ["  " + l for l in wrap(payload, width - 4, accent, base)] + [""]
    tidy = []
    for line in out:  # collapse runs of blank lines
        if not (line == "" and tidy and tidy[-1] == ""):
            tidy.append(line)
    return tidy


# --------------------------------------------------------------------------
# Section selection, search, output
# --------------------------------------------------------------------------

def headings(blocks):
    return [(i, lvl, plain(p)) for i, (k, lvl, p) in enumerate(blocks) if k == "heading"]


def select(blocks, query):
    q = ALIASES.get(query.lower(), query.lower())
    heads = headings(blocks)
    for want in (2, 3):  # prefer a top-level section over a subsection
        for idx, lvl, title in heads:
            if lvl == want and q in title.lower():
                end = next((j for j, l, _ in heads if j > idx and l <= lvl), len(blocks))
                chosen = blocks[idx:end]
                if lvl == 3:  # keep the parent section header for its colour and context
                    parent = next(b for b in reversed(blocks[:idx]) if b[0] == "heading" and b[1] == 2)
                    chosen = [parent] + chosen
                return chosen
    return None


def search_rows(blocks):
    """One line per binding for fzf: where it lives, the keys, what they do."""
    rows, section, sub, accent = [], "", "", DEFAULT_COLOUR
    for kind, level, payload in blocks:
        if kind == "heading" and level == 2:
            section, sub, accent = plain(payload), "", section_colour(plain(payload))
        elif kind == "heading" and level == 3:
            sub = re.sub(r"\s*\(.*\)", "", plain(payload))
        elif kind == "table":
            rows += [(section, sub, r[0], " ".join(r[1:]), accent) for r in keys_first(payload)[1:]]
        elif kind == "bullet" and payload.startswith("`"):
            m = re.match(r"(.+?)(?:\s+[—–-]\s+|:\s+)(.+)", payload)
            if m:
                rows.append((section, sub, m.group(1), m.group(2), accent))
    where = [f"{s} › {b}" if b else s for s, b, *_ in rows]
    where_w = max(map(len, where))
    key_w = min(max(len(plain(r[2])) for r in rows), 30)
    lines = []
    for w, (_, _, k, a, acc) in zip(where, rows):
        key = " ".join(words(k, acc))
        lines.append(sgr(38, 5, acc) + w.ljust(where_w) + reset() + "  "
                     + key + " " * max(key_w - visible_len(key), 0) + "  " + plain(a))
    return lines


def emit(lines):
    text = "\n".join(lines) + "\n"
    if sys.stdout.isatty() and shutil.which("less") \
            and len(lines) > shutil.get_terminal_size().lines - 1:
        subprocess.run(["less", "-RFi"], input=text, text=True)
    else:
        sys.stdout.write(text)


def main(argv):
    global COLOUR
    if argv and argv[0] in ("-h", "--help"):
        print(textwrap.dedent(__doc__).strip())
        return

    path = find_keys_md()
    try:
        with open(path, encoding="utf-8") as f:
            blocks = parse(f.read())
    except OSError:
        sys.exit(f"keys: cannot read {path} (set KEYS_MD to point at it)")

    if argv and argv[0] in ("-l", "--list"):
        for _, lvl, title in headings(blocks):
            if lvl > 1:
                print(("  " if lvl == 2 else "      ") + title)
        return

    if argv and argv[0] in ("-s", "--search", "/"):
        if not shutil.which("fzf"):
            sys.exit("keys: -s needs fzf")
        COLOUR = "NO_COLOR" not in os.environ  # fzf draws the ANSI even though stdout is a pipe
        fzf = ["fzf", "--ansi", "--no-sort", "--layout=reverse", "--height=90%",
               "--prompt=keys › ", "--header=type to filter · esc to quit"]
        if argv[1:]:
            fzf.append("--query=" + " ".join(argv[1:]))
        subprocess.run(fzf, input="\n".join(search_rows(blocks)), text=True)
        return

    if argv:
        chosen = select(blocks, " ".join(argv))
        if chosen is None:
            sys.exit(f"keys: no section matches '{' '.join(argv)}' (try keys -l)")
        blocks = chosen

    emit(render(blocks, min(shutil.get_terminal_size().columns, 110)))


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (KeyboardInterrupt, BrokenPipeError):
        pass
